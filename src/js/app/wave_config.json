{
  "key": "wave",
  "meta": {
    "label": "Wave Field",
    "group": "physical",
    "thumbnail": "bi-water"
  },
  "intro": {
    "summary": "Wind-driven surface waves over a dynamic water field",
    "paragraphs": [
      "This app models a wind-driven water surface as a sum of propagating wave components with deep-water dispersion.",
      "Wind speed and direction shape the spectrum, while choppiness and damping control crest sharpness and energy roll-off."
    ]
  },
  "model": {
    "subtitle": "Spectral-style multi-component surface wave synthesis with wind-coupled parameters.",
    "references": [
      {
        "label": "dli/waves (WebGL ocean)",
        "url": "https://github.com/dli/waves"
      },
      {
        "label": "Tessendorf: Simulating Ocean Water",
        "url": "https://people.computing.clemson.edu/~jtessen/reports/papers_files/coursenotes2002.pdf"
      }
    ],
    "items": [
      {
        "title": "Surface Height",
        "equation": "$$\\eta(\\mathbf{x},t)=\\sum_{i=1}^{N}A_i\\sin(\\mathbf{k}_i\\cdot\\mathbf{x}+\\omega_i t+\\phi_i)$$",
        "explanation": "The water surface is synthesized from multiple traveling wave components with different wavelengths, directions, and phases.",
        "parameters": [
          "<strong>Component Count</strong> (\\(N\\)) sets spectral richness.",
          "<strong>Wave Amplitude Scale</strong> (\\(A_0\\)) scales vertical displacement energy."
        ]
      },
      {
        "title": "Dispersion",
        "equation": "$$\\omega_i=\\sqrt{g\\,k_i},\\qquad k_i=\\frac{2\\pi}{\\lambda_i}$$",
        "explanation": "Each component follows deep-water dispersion so shorter wavelengths propagate with different phase speed than longer waves.",
        "parameters": [
          "<strong>Base Wavelength</strong> (\\(\\lambda_0\\)) anchors the component wavelength band."
        ]
      },
      {
        "title": "Wind-Coupled Directional Spectrum",
        "equation": "$$A_i=A_0\\,f(U,\\theta_w,\\Delta\\theta,\\lambda_i)\\,e^{-\\zeta k_i},\\quad \\mathbf{\\hat k}_i\\sim\\mathcal{D}(\\theta_w,\\Delta\\theta)$$",
        "explanation": "Wind speed and direction bias component orientation and energy. Direction spread broadens or narrows the directional distribution, while damping attenuates higher-wave-number components.",
        "parameters": [
          "<strong>Wind Speed</strong> (\\(U\\)) increases energy input.",
          "<strong>Wind Direction</strong> (\\(\\theta_w\\)) sets dominant propagation direction.",
          "<strong>Direction Spread</strong> (\\(\\Delta\\theta\\)) controls angular spread around wind direction.",
          "<strong>Damping</strong> (\\(\\zeta\\)) controls high-frequency energy attenuation."
        ]
      },
      {
        "title": "Choppy Horizontal Displacement",
        "equation": "$$\\mathbf{x}'=\\mathbf{x}+\\chi\\sum_{i=1}^{N}A_i\\cos(\\mathbf{k}_i\\cdot\\mathbf{x}+\\omega_i t+\\phi_i)\\,\\hat{\\mathbf{k}}_i$$",
        "explanation": "A choppiness factor adds horizontal crest skew to create sharper, more realistic wave profiles.",
        "parameters": [
          "<strong>Choppiness</strong> (\\(\\chi\\)) controls crest sharpening.",
          "<strong>Damping</strong> attenuates high-frequency contribution."
        ]
      }
    ]
  },
