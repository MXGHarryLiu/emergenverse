{
  "key": "wave",
  "meta": {
    "label": "Wave Field",
    "group": "physical",
    "thumbnail": "bi-water"
  },
  "intro": {
    "summary": "FFT-based directional ocean surface synthesis",
    "paragraphs": [
      "This app models open-ocean waves in frequency space, then reconstructs the surface with a 2D inverse FFT each step.",
      "Wind speed and direction drive the spectrum directly, while directional spread, damping, and choppiness shape crest sharpness and anisotropy."
    ]
  },
  "model": {
    "subtitle": "Directional spectral ocean simulation with phase evolution and GPU FFT reconstruction.",
    "references": [
      {
        "label": "dli/waves (WebGL ocean)",
        "url": "https://github.com/dli/waves"
      },
      {
        "label": "Tessendorf: Simulating Ocean Water",
        "url": "https://people.computing.clemson.edu/~jtessen/reports/papers_files/coursenotes2002.pdf"
      },
      {
        "label": "JONSWAP Wave Spectrum",
        "url": "https://en.wikipedia.org/wiki/JONSWAP"
      }
    ],
    "items": [
      {
        "title": "Surface Reconstruction",
        "equation": "$$\\eta(\\mathbf{x},t)=\\sum_{\\mathbf{k}}\\hat{h}(\\mathbf{k},t)e^{i\\mathbf{k}\\cdot\\mathbf{x}}$$",
        "explanation": "The ocean surface is reconstructed from complex Fourier amplitudes over a 2D wave-number grid.",
        "parameters": [
          "<strong>FFT Resolution</strong> (\\(N\\)) controls spectral detail.",
          "<strong>Mesh Resolution</strong> controls visible geometric tessellation."
        ]
      },
      {
        "title": "Complex Amplitude Evolution",
        "equation": "$$\\hat{h}(\\mathbf{k},t)=h_0(\\mathbf{k})e^{i\\omega t}+h_0^*(-\\mathbf{k})e^{-i\\omega t}$$",
        "explanation": "Each frequency evolves by rotating phase with dispersion, combining conjugate modes to keep real-valued displacement.",
        "parameters": [
          "<strong>Time Step</strong> controls phase advance per simulation update."
        ]
      },
      {
        "title": "Dispersion",
        "equation": "$$\\omega(k)=\\sqrt{gk\\left(1+\\left(\\frac{k}{k_m}\\right)^2\\right)},\\qquad k_p=g\\left(\\frac{\\Omega}{U_{10}}\\right)^2$$",
        "explanation": "Higher wave numbers propagate differently from long swells, producing physically plausible mixed-sea motion.",
        "parameters": [
          "<strong>Wind Speed</strong> shifts dominant wave-number band through the wind-coupled peak wave number."
        ]
      },
      {
        "title": "Directional Spectrum + Choppiness",
        "equation": "$$h_0(\\mathbf{k})\\propto\\sqrt{S(k,\\theta)}\\,\\xi,\\qquad \\mathbf{x}'=\\mathbf{x}+\\chi\\,\\nabla\\eta$$",
        "explanation": "Wind-aligned directional energy and stochastic phase seed the spectrum; horizontal displacement sharpens crests.",
        "parameters": [
          "<strong>Wind Speed</strong> and <strong>Wind Direction</strong> set dominant energy flow.",
          "<strong>Direction Spread</strong> controls angular broadness around wind direction.",
          "<strong>Spectrum Scale</strong>, <strong>Damping</strong>, and <strong>Choppiness</strong> tune sea state energy and crest sharpness."
        ]
      }
    ]
  },
