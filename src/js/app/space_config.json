{
  "key": "space",
  "meta": {
    "label": "Space Field",
    "group": "physical",
    "thumbnail": "bi-stars"
  },
  "intro": {
    "summary": "Galaxy-style dynamics with a particle-mesh gravity field",
    "paragraphs": [
      "This app keeps the familiar galaxy control surface while switching the core dynamics to a gravity field solved on a grid.",
      "You still shape initial structure and orbital behavior with galaxy-like parameters, but the field solve supports denser visual populations efficiently."
    ]
  },
  "model": {
    "references": [
      {
        "label": "Wikipedia: Particle-mesh method",
        "url": "https://en.wikipedia.org/wiki/Particle_mesh"
      },
      {
        "label": "Wikipedia: N-body simulation",
        "url": "https://en.wikipedia.org/wiki/N-body_simulation"
      },
      {
        "label": "Wikipedia: Galaxy formation and evolution",
        "url": "https://en.wikipedia.org/wiki/Galaxy_formation_and_evolution"
      }
    ],
    "journalArticles": [
      {
        "title": "A Hierarchical O(N log N) Force-Calculation Algorithm",
        "url": "https://doi.org/10.1038/324446a0"
      }
    ],
    "items": [
      {
        "title": "Position (\\(x\\))",
        "equation": "$$\\mathbf{x}_i(t+\\Delta t)=\\mathbf{x}_i(t)+\\mathbf{v}_i(t)\\,\\Delta t$$",
        "explanation": "Each particle advances according to its current orbital velocity."
      },
      {
        "title": "Velocity (\\(v\\))",
        "equation": "$$\\mathbf{v}_i(t+\\Delta t)=\\mathbf{v}_i(t)+\\mathbf{a}_i(t)\\,\\Delta t$$",
        "explanation": "Velocity changes in response to acceleration from the solved gravity field."
      },
      {
        "title": "Field Gravity (Particle-Mesh)",
        "equation": "$$\\nabla^2\\phi=4\\pi G_f\\left(\\rho-\\bar{\\rho}\\right),\\quad \\mathbf{a}_i=-\\beta\\,\\nabla\\phi(\\mathbf{x}_i)+G_f\\,M_c\\,\\frac{-\\mathbf{x}_i}{\\left(\\|\\mathbf{x}_i\\|^2+\\epsilon^2\\right)^{3/2}},\\quad m_p=\\frac{M_{\\mathrm{obj}}}{N}$$",
        "explanation": "Mass is deposited to a mesh, potential is solved, and acceleration is sampled back to particles. The blend factor \\(\\beta\\) scales self-field strength relative to central attraction, while softening prevents singular center forces.",
        "parameters": [
          "<strong>Central Mass</strong> (\\(M_c\\)) controls binding toward the center.",
          "<strong>Object Total Mass</strong> (\\(M_{\\mathrm{obj}}\\)) sets the total self-gravitating tracer mass.",
          "<strong>Count</strong> (\\(N\\)) sets tracer population; per-tracer mass is \\(m_p=M_{\\mathrm{obj}}/N\\).",
          "<strong>Field Resolution</strong> (\\(r_g\\)) sets mesh density; effective grid size scales with world span.",
          "<strong>Softening</strong> (\\(\\epsilon\\)) sets short-range smoothing."
        ]
      },
      {
        "title": "Initialization",
        "equation": "$$\\begin{aligned}\\mathbf{x}_i(0)&\\sim p_{\\mathrm{shape}}\\!\\left(R_0,\\,L_x,\\,L_y,\\,L_z\\right)\\\\\\left\\|\\mathbf{v}_i(0)\\right\\|&\\approx s\\,\\sqrt{\\frac{G_f\\,M_{\\mathrm{eff}}(r_i)}{r_i}},\\quad M_{\\mathrm{eff}}(r)=M_c+\\beta\\,M_{\\mathrm{enc}}(r)\\end{aligned}$$",
        "explanation": "Tracers are seeded from the selected initial shape within the configured initial radius, then assigned near-tangential orbital speeds scaled by spin and local effective enclosed mass.",
        "parameters": [
          "<strong>Initial Shape</strong> selects sampling geometry (disk, cloud, sphere, ellipsoid).",
          "<strong>Initial Radius</strong> (\\(R_0\\)) sets spawn extent before clamping to world bounds.",
          "<strong>Initial Orbital Speed</strong> (\\(s\\)) scales the circular-speed baseline used for seeded velocities.",
          "<strong>World Sizes</strong> (\\(L_x,L_y,L_z\\)) define the initialization domain extents."
        ]
      }
    ]
  },
