{
  "key": "prey",
  "meta": {
    "label": "Prey Chain",
    "group": "organic",
    "thumbnail": "bi-bullseye"
  },
  "intro": {
    "summary": "Predator-prey cycles and chase dynamics",
    "paragraphs": [
      "Population booms and crashes can arise from repeated chase, escape, and reproduction cycles.",
      "Lotka-Volterra terms, predation radius, birth rate, and predator energy gain/loss trace a shifting rhythm where survival and pursuit take turns at center stage."
    ]
  },
  "model": {
    "subtitle": "Population balance coupled to local chase-and-escape motion.",
    "references": [
      {
        "label": "Wikipedia: Lotka-Volterra equations",
        "url": "https://en.wikipedia.org/wiki/Lotka%E2%80%93Volterra_equations"
      },
      {
        "label": "Wikipedia: Food chain",
        "url": "https://en.wikipedia.org/wiki/Food_chain"
      }
    ],
    "journalArticles": [
      {
        "title": "Analytical Note on Certain Rhythmic Relations in Organic Systems",
        "url": "https://doi.org/10.1073/pnas.6.7.410"
      }
    ],
    "items": [
      {
        "title": "Population Balance",
        "equation": "$$\\begin{aligned}x(t+\\Delta t)&=x(t)+\\left(\\alpha x(t)-\\beta x(t)y(t)\\right)\\Delta t\\\\y(t+\\Delta t)&=y(t)+\\left(\\delta x(t)y(t)-\\gamma y(t)\\right)\\Delta t\\end{aligned}$$",
        "explanation": "Prey can grow on their own, while predator-prey encounters transfer energy and change both populations over time.",
        "parameters": [
          "<strong>Prey Count</strong> (\\(x\\)) sets the initial prey population.",
          "<strong>Predator Count</strong> (\\(y\\)) sets the initial predator population.",
          "<strong>Prey Birth Rate</strong> (\\(\\alpha\\)) sets the prey growth tendency.",
          "<strong>Predation Rate</strong> (\\(\\beta\\)) scales encounter pressure.",
          "<strong>Predator Gain</strong> (\\(\\delta\\)) controls how much predators benefit from captures.",
          "<strong>Predator Energy Loss</strong> (\\(\\gamma\\)) sets background predator decline."
        ]
      },
      {
        "title": "Position (\\(p\\))",
        "equation": "$$\\mathbf{p}_{q,k}(t+\\Delta t)=\\mathbf{p}_{q,k}(t)+\\mathbf{v}_{q,k}(t)\\Delta t,\\qquad q\\in\\{x,y\\},\\;k=1,\\dots,N_q$$",
        "explanation": "Each prey or predator agent advances using its current velocity.",
        "parameters": [
          "<strong>Species Index</strong> (\\(q\\)) uses \\(q=x\\) for prey and \\(q=y\\) for predator.",
          "<strong>Agent Index</strong> (\\(k\\)) runs over individuals within each species: \\(k=1,\\dots,N_q\\)."
        ]
      },
      {
        "title": "Velocity (\\(v\\))",
        "equation": "$$\\mathbf{v}_{q,k}(t+\\Delta t)=\\mathrm{norm}\\!\\left(\\mathbf{v}_{q,k}(t)+\\mathbf{u}_{q,k}(t)\\Delta t\\right)\\,s_q,\\qquad q\\in\\{x,y\\}$$",
        "explanation": "Direction changes through pursuit/evasion steering, then velocity is renormalized to the species speed.",
        "parameters": [
          "<strong>Prey Speed</strong> (\\(s_x\\)) and <strong>Predator Speed</strong> (\\(s_y\\)) set travel rates by species.",
          "<strong>Steering Input</strong> (\\(\\mathbf{u}_{q,k}\\)) is the species-and-agent-specific chase/escape direction update."
        ]
      },
      {
        "title": "Sense Neighborhood",
        "equation": "$$\\mathcal{N}^{\\mathrm{sense}}_{y,k}(t)=\\left\\{j\\in\\{1,\\dots,N_x\\}:\\left\\lVert\\mathbf{p}_{x,j}(t)-\\mathbf{p}_{y,k}(t)\\right\\rVert\\le r_{\\mathrm{sense}}\\right\\}$$",
        "explanation": "Each predator \\((y,k)\\) senses prey only within a finite radius, and steering targets are computed from this local neighborhood.",
        "parameters": [
          "<strong>Sense Radius</strong> (\\(r_{\\mathrm{sense}}\\)) sets predator detection range."
        ]
      },
      {
        "title": "Predation Neighborhood",
        "equation": "$$\\mathcal{N}^{\\mathrm{pred}}_{y,k}(t)=\\left\\{j\\in\\{1,\\dots,N_x\\}:\\left\\lVert\\mathbf{p}_{x,j}(t)-\\mathbf{p}_{y,k}(t)\\right\\rVert\\le r_{\\mathrm{pred}}\\right\\}$$",
        "explanation": "A prey is capturable only when it lies inside the predator's predation radius.",
        "parameters": [
          "<strong>Predation Radius</strong> (\\(r_{\\mathrm{pred}}\\)) sets the capture distance threshold."
        ]
      },
      {
        "title": "Initialization",
        "equation": "$$\\begin{aligned}\\mathbf{p}_{q,k}(0)&\\sim \\mathcal{U}\\!\\left([-0.45L_x,0.45L_x]\\times[-0.45L_y,0.45L_y]\\times\\{0\\}\\right)\\\\\\left\\lVert\\mathbf{v}_{q,k}(0)\\right\\rVert&=s_q,\\qquad q\\in\\{x,y\\},\\;k=1,\\dots,N_q\\end{aligned}$$",
        "explanation": "Agents start from a uniform random cloud over the floor plane using 90% of world span in x and y, with random heading and species-specific speed magnitude.",
        "parameters": [
          "<strong>World Sizes</strong> (\\(L_x,L_y\\)) set the spawn area extent.",
          "<strong>Prey Speed</strong> (\\(s_x\\)) and <strong>Predator Speed</strong> (\\(s_y\\)) set initialization speed by species."
        ]
      }
    ]
  },
