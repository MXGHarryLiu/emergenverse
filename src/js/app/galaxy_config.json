{
  "key": "galaxy",
  "meta": {
    "label": "Galaxy Gravity",
    "group": "physical",
    "thumbnail": "bi-globe2"
  },
  "intro": {
    "summary": "N-body gravity shaping orbital structure",
    "paragraphs": [
      "A rotating cloud of matter can self-organize into striking structures under gravity alone.",
      "Softened gravity, central mass, object total mass, and orbital spin sculpt acceleration and binding into arcs and clusters that slowly reveal a cosmic architecture."
    ]
  },
  "model": {
    "references": [
      {
        "label": "Wikipedia: N-body simulation",
        "url": "https://en.wikipedia.org/wiki/N-body_simulation"
      },
      {
        "label": "Wikipedia: Galaxy formation and evolution",
        "url": "https://en.wikipedia.org/wiki/Galaxy_formation_and_evolution"
      }
    ],
    "journalArticles": [
      {
        "title": "A Hierarchical O(N log N) Force-Calculation Algorithm",
        "url": "https://doi.org/10.1038/324446a0"
      }
    ],
    "items": [
      {
        "title": "Position (\\(x\\))",
        "equation": "$$\\mathbf{x}_i(t+\\Delta t)=\\mathbf{x}_i(t)+\\mathbf{v}_i(t)\\,\\Delta t$$",
        "explanation": "Each particle advances according to its current orbital velocity."
      },
      {
        "title": "Velocity (\\(v\\))",
        "equation": "$$\\mathbf{v}_i(t+\\Delta t)=\\mathbf{v}_i(t)+\\mathbf{a}_i(t)\\,\\Delta t$$",
        "explanation": "Velocity changes in response to the current gravitational acceleration."
      },
      {
        "title": "Softened Gravity",
        "equation": "$$\\mathbf{a}_i=G\\sum_{j\\ne i}m_p\\frac{\\mathbf{r}_{ji}}{\\left(\\|\\mathbf{r}_{ji}\\|^2+\\epsilon^2\\right)^{3/2}}+G\\,M_c\\frac{-\\mathbf{x}_i}{\\left(\\|\\mathbf{x}_i\\|^2+\\epsilon^2\\right)^{3/2}},\\quad m_p=\\frac{M_{\\mathrm{obj}}}{N}$$",
        "explanation": "Acceleration combines particle-particle attraction with a pull from the central mass, while softening prevents singular forces at very small separations. In this applet, G is fixed to the physical SI gravitational constant and converted internally into galaxy units.",
        "parameters": [
          "<strong>Central Mass</strong> (\\(M_c\\)) controls how strongly the system stays bound to the center.",
          "<strong>Object Total Mass</strong> (\\(M_{\\mathrm{obj}}\\)) sets the total self-gravitating mass represented by particles.",
          "<strong>Count</strong> (\\(N\\)) changes resolution; per-particle mass is \\(m_p=M_{\\mathrm{obj}}/N\\).",
          "<strong>Softening</strong> (\\(\\epsilon\\)) sets the short-range smoothing scale."
        ]
      },
      {
        "title": "Initialization",
        "equation": "$$\\begin{aligned}\\mathbf{x}_i(0)&\\sim p_{\\mathrm{shape}}\\!\\left(R_0,\\,L_x,\\,L_y,\\,L_z\\right)\\\\\\left\\|\\mathbf{v}_i(0)\\right\\|&\\approx s\\,\\sqrt{\\frac{G\\,M_{\\mathrm{enc}}(r_i)}{r_i}}\\end{aligned}$$",
        "explanation": "Particles are seeded from the selected initial shape within the configured initial radius, then assigned near-tangential orbital velocities scaled by the spin factor and local enclosed mass.",
        "parameters": [
          "<strong>Initial Shape</strong> selects the sampling geometry (disk, cloud, sphere, ellipsoid).",
          "<strong>Initial Radius</strong> (\\(R_0\\)) sets the spawn extent before clamping to world bounds.",
          "<strong>Initial Orbital Speed</strong> (\\(s\\)) scales the circular-speed baseline used for initial velocities.",
          "<strong>World Sizes</strong> (\\(L_x,L_y,L_z\\)) define the domain extents that bound initialization."
        ]
      }
    ]
  },
